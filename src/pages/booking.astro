---
import { ClientRouter } from 'astro:transitions';
import SeoHead from '@components/SeoHead.astro';
import ThemeInit from '@components/ThemeInit.astro';
import SiteFonts from '@components/SiteFonts.astro';
import SiteIcons from '@components/SiteIcons.astro';
import Header from '@components/Header.astro';
import '@styles/root.less';
import '@styles/dark.less';
import '@styles/global.css';

---

<!-- A fully fleshed-out <head>, dynamically changing based on client.json and the page front matter -->
<html lang="en">
  <head>
    <!-- View Transitions support -->
    <ClientRouter />

    <!-- Standard meta tags -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SiteFonts />
    <SeoHead />

    <!--Favicons-->
    <SiteIcons />
    <meta name="msapplication-TileColor" content="#da532c" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Sitewide Scripts -->
    <script src="@js/nav.js"></script>
  </head>
  <body>
    <ThemeInit />
    <!--Screen reader skip main nav-->
    <a class="skip" aria-label="skip to main content" href="#main"
      >Click To Skip To Main Content</a
    >

    <Header />
    <main id="main" class="booking-page relative">
      <p class="booking-alternative">
        Prefer to book directly?
        <a href="https://www.massagebook.com/therapists/StoneMassage?src=external">Book an in-clinic appointment on MassageBook</a>.
        For in-home massage, <a href="tel:587-938-0458">call (587) 938-0458</a>.
      </p>
      <iframe
        title="Stone Massage in-clinic appointment booking through MassageBook"
        src="https://www.massagebook.com/therapists/StoneMassage/widget/services"
        width="100%"
        height="1000"></iframe>
    </main>
  </body>
</html>

<style>
  .booking-page {
    padding-block-start: 10rem;
  }

  .booking-alternative {
    max-width: 75ch;
    margin: 0 auto;
    padding: 1.5rem 1rem;
    color: var(--bodyTextColor);
    line-height: 1.5;
  }

  .booking-alternative a {
    color: var(--link-color);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  iframe {
    display: block;
    width: 100%;
    min-height: 100dvh;
    border: 0;
    background: #fff;
    color-scheme: light;
  }
</style>
