---
import BaseLayout from "src/layouts/BaseLayout.astro";
import CTA from "@components/CTA.astro";
import Landing from "@components/Landing.astro";
import { getOptimizedImage } from "@js/utils";
import landingImage from "@assets/images/stone-massage-background1.png";
import ogImage from "@assets/images/CTA/gallery-og.jpg";

const optimizedImage = await getOptimizedImage(landingImage);
const optimizedOg = await getOptimizedImage(ogImage);

const galleries = [
  {
    id: "clinic",
    label: "Inside Our Clinic",
    description: "A quiet look inside the treatment space prepared for your visit.",
    images: [
      { src: "/assets/images/clinic1.png", alt: "Stone Massage clinic treatment room" },
      { src: "/assets/images/clinic2.png", alt: "Treatment area inside the Stone Massage clinic" },
      { src: "/assets/images/clinic3.png", alt: "A welcoming view inside the Stone Massage clinic" },
    ],
  },
  {
    id: "experience",
    label: "Client Experience",
    description: "The restorative details and treatments that shape each appointment.",
    images: [
      { src: "/assets/images/stone-massage-background1.png", alt: "Hot stone massage treatment" },
      { src: "/assets/images/stone-massage-back.png", alt: "Massage treatment focused on the back" },
      { src: "/assets/images/stone-massage-feet.png", alt: "Massage treatment focused on the feet" },
    ],
  },
  {
    id: "events",
    label: "Events & Specials",
    description: "Moments from Stone Massage beyond the everyday treatment room.",
    images: [
      { src: "/assets/images/stone-massage-feet.png", alt: "Foot massage treatment presentation" },
      { src: "/assets/images/clinic2.png", alt: "Stone Massage clinic prepared for clients" },
      { src: "/assets/images/stone-massage-background1.png", alt: "Hot stone massage presentation" },
    ],
  },
];
---

<BaseLayout
  title="Gallery"
  description="Explore the Stone Massage clinic, client experience, events, and specials in Edmonton."
  preloadedImage={optimizedImage}
  ogImage={optimizedOg}
>
  <Landing title="Gallery" image={optimizedImage} />

  <section id="gallery" class="gallery" aria-labelledby="gallery-heading">
    <div class="gallery__container">
      <div class="gallery__intro">
        <h2 id="gallery-heading">A closer look at Stone Massage</h2>
        <p>Explore the space, treatments, and details that make each visit feel considered.</p>
      </div>

      <div class="gallery__tabs" role="tablist" aria-label="Gallery categories">
        {galleries.map((gallery, index) => (
          <button
            class="gallery__tab"
            type="button"
            role="tab"
            id={`gallery-tab-${gallery.id}`}
            aria-controls={`gallery-panel-${gallery.id}`}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? 0 : -1}
            data-gallery-tab={gallery.id}
          >
            <span>{gallery.label}</span>
            <span class="gallery__count" aria-label={`${gallery.images.length} photos`}>{String(gallery.images.length).padStart(2, "0")}</span>
          </button>
        ))}
      </div>

      {galleries.map((gallery, galleryIndex) => (
        <div
          class="gallery__panel"
          id={`gallery-panel-${gallery.id}`}
          role="tabpanel"
          aria-labelledby={`gallery-tab-${gallery.id}`}
          hidden={galleryIndex !== 0}
          data-gallery-panel={gallery.id}
        >
          <div class="gallery__panel-heading">
            <h3>{gallery.label}</h3>
            <p>{gallery.description}</p>
          </div>

          <div class="gallery__grid">
            {gallery.images.map((image, imageIndex) => (
              <button
                class:list={["gallery__image", { "gallery__image--lead": imageIndex === 0 }]}
                type="button"
                data-viewer-image
                data-src={image.src}
                data-alt={image.alt}
                data-category={gallery.label}
                aria-label={`Open photo ${imageIndex + 1} of ${gallery.images.length}: ${image.alt}`}
                style={`--image-index: ${imageIndex}`}
              >
                <img src={image.src} alt={image.alt} width="960" height="720" loading="lazy" decoding="async" />
                <span class="gallery__image-action" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M15 3h6v6M21 3l-7 7M9 21H3v-6M3 21l7-7" />
                  </svg>
                  View
                </span>
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <dialog class="gallery-viewer" aria-labelledby="gallery-viewer-caption">
    <div class="gallery-viewer__frame">
      <button class="gallery-viewer__close" type="button" aria-label="Close image viewer">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" />
        </svg>
      </button>
      <div class="gallery-viewer__media">
        <img src="" alt="" width="1440" height="1080" />
      </div>
      <div class="gallery-viewer__footer">
        <p id="gallery-viewer-caption"></p>
        <div class="gallery-viewer__controls">
          <button type="button" data-viewer-previous aria-label="View previous photo">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <span class="gallery-viewer__position" aria-live="polite"></span>
          <button type="button" data-viewer-next aria-label="View next photo">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>
    </div>
  </dialog>

  <CTA />
</BaseLayout>

<script>
  document.addEventListener("astro:page-load", () => {
    const gallery = document.getElementById("gallery");
    const dialog = document.querySelector<HTMLDialogElement>(".gallery-viewer");
    if (!gallery || !dialog || gallery.dataset.initialized === "true") return;
    gallery.dataset.initialized = "true";

    const tabs = Array.from(gallery.querySelectorAll<HTMLButtonElement>("[data-gallery-tab]"));
    const panels = Array.from(gallery.querySelectorAll<HTMLElement>("[data-gallery-panel]"));
    const viewerImage = dialog.querySelector<HTMLImageElement>(".gallery-viewer__media img");
    const caption = dialog.querySelector<HTMLElement>("#gallery-viewer-caption");
    const position = dialog.querySelector<HTMLElement>(".gallery-viewer__position");
    const closeButton = dialog.querySelector<HTMLButtonElement>(".gallery-viewer__close");
    let activeImages: HTMLButtonElement[] = [];
    let activeImageIndex = 0;

    const selectTab = (tab: HTMLButtonElement, moveFocus = false) => {
      const tabId = tab.dataset.galleryTab;
      tabs.forEach((item) => {
        const selected = item === tab;
        item.setAttribute("aria-selected", String(selected));
        item.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel) => {
        panel.hidden = panel.dataset.galleryPanel !== tabId;
      });
      if (moveFocus) tab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", (event) => {
        let nextIndex = index;
        if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
        else if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (event.key === "Home") nextIndex = 0;
        else if (event.key === "End") nextIndex = tabs.length - 1;
        else return;
        event.preventDefault();
        selectTab(tabs[nextIndex], true);
      });
    });

    const updateViewer = () => {
      const trigger = activeImages[activeImageIndex];
      if (!trigger || !viewerImage || !caption || !position) return;
      viewerImage.src = trigger.dataset.src ?? "";
      viewerImage.alt = trigger.dataset.alt ?? "";
      caption.textContent = `${trigger.dataset.category} — ${trigger.dataset.alt}`;
      position.textContent = `${activeImageIndex + 1} / ${activeImages.length}`;
    };

    gallery.querySelectorAll<HTMLButtonElement>("[data-viewer-image]").forEach((trigger) => {
      trigger.addEventListener("click", () => {
        const panel = trigger.closest<HTMLElement>("[data-gallery-panel]");
        activeImages = panel ? Array.from(panel.querySelectorAll<HTMLButtonElement>("[data-viewer-image]")) : [];
        activeImageIndex = activeImages.indexOf(trigger);
        updateViewer();
        dialog.showModal();
      });
    });

    closeButton?.addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-viewer-previous]")?.addEventListener("click", () => {
      activeImageIndex = (activeImageIndex - 1 + activeImages.length) % activeImages.length;
      updateViewer();
    });
    dialog.querySelector("[data-viewer-next]")?.addEventListener("click", () => {
      activeImageIndex = (activeImageIndex + 1) % activeImages.length;
      updateViewer();
    });
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener("keydown", (event) => {
      if (event.key === "ArrowLeft") {
        activeImageIndex = (activeImageIndex - 1 + activeImages.length) % activeImages.length;
        updateViewer();
      }
      if (event.key === "ArrowRight") {
        activeImageIndex = (activeImageIndex + 1) % activeImages.length;
        updateViewer();
      }
    });
  });
</script>

<style lang="less">
  .gallery {
    --gallery-ink: #1a1a1a;
    --gallery-muted: #5f5260;
    --gallery-paper: #fffafc;
    padding: clamp(4.5rem, 9vw, 8rem) 1rem;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgba(243, 17, 126, 0.035), transparent 18rem),
      #fff;
  }

  .gallery__container {
    width: min(100%, 82.5rem);
    margin-inline: auto;
  }

  .gallery__intro {
    max-width: 45rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    text-align: left;
  }

  .gallery__intro h2 {
    max-width: 15ch;
    margin: 0 0 1rem;
    color: var(--gallery-ink);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .gallery__intro p,
  .gallery__panel-heading p {
    margin: 0;
    color: var(--gallery-muted);
    font-size: clamp(1rem, 1.5vw, 1.125rem);
    line-height: 1.65;
  }

  .gallery__tabs {
    display: flex;
    gap: 0;
    margin-bottom: clamp(2.5rem, 6vw, 5rem);
    overflow-x: auto;
    border-bottom: 1px solid #e8dfe4;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
  }

  .gallery__tabs::-webkit-scrollbar {
    display: none;
  }

  .gallery__tab {
    position: relative;
    display: flex;
    flex: 1 0 auto;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
    padding: 0.75rem clamp(1rem, 2.5vw, 2rem);
    border: 0;
    background: transparent;
    color: #756873;
    font: inherit;
    font-size: clamp(0.875rem, 1.4vw, 1rem);
    font-weight: 700;
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
    scroll-snap-align: start;
    transition: color 240ms ease, background-color 240ms ease;
  }

  .gallery__tab::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -1px;
    left: 0;
    height: 3px;
    background: #f3117e;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery__tab:hover {
    color: var(--gallery-ink);
    background: rgba(243, 17, 126, 0.035);
  }

  .gallery__tab[aria-selected="true"] {
    color: var(--gallery-ink);
  }

  .gallery__tab[aria-selected="true"]::after {
    transform: scaleX(1);
  }

  .gallery__count {
    color: #b54d7f;
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .gallery__panel[hidden] {
    display: none;
  }

  .gallery__panel:not([hidden]) {
    animation: panel-reveal 550ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .gallery__panel-heading {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .gallery__panel-heading h3 {
    margin: 0;
    color: var(--gallery-ink);
    font-size: clamp(1.4rem, 2.5vw, 2rem);
    font-weight: 600;
    line-height: 1.2;
  }

  .gallery__panel-heading p {
    max-width: 34rem;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(2, clamp(11rem, 25vw, 20rem));
    gap: clamp(0.65rem, 1.5vw, 1.25rem);
  }

  .gallery__image {
    position: relative;
    min-width: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: 0.5rem;
    background: #eadfe4;
    cursor: zoom-in;
    isolation: isolate;
    animation: image-reveal 650ms calc(var(--image-index) * 90ms) cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .gallery__image--lead {
    grid-row: 1 / 3;
  }

  .gallery__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.16, 1, 0.3, 1), filter 500ms ease;
  }

  .gallery__image::after {
    content: "";
    position: absolute;
    inset: 50% 0 0;
    z-index: 1;
    background: linear-gradient(transparent, rgba(22, 12, 17, 0.58));
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .gallery__image-action {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    border-radius: 2rem;
    background: rgba(255, 250, 252, 0.94);
    color: #1a1a1a;
    font-size: 0.8125rem;
    font-weight: 700;
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 300ms ease, transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .gallery__image:hover img {
    transform: scale(1.035);
    filter: saturate(1.05);
  }

  .gallery__image:hover::after,
  .gallery__image:hover .gallery__image-action,
  .gallery__image:focus-visible::after,
  .gallery__image:focus-visible .gallery__image-action {
    opacity: 1;
  }

  .gallery__image:hover .gallery__image-action,
  .gallery__image:focus-visible .gallery__image-action {
    transform: translateY(0);
  }

  .gallery__tab:focus-visible,
  .gallery__image:focus-visible,
  .gallery-viewer button:focus-visible {
    outline: 3px solid #f3117e;
    outline-offset: 4px;
  }

  .gallery-viewer {
    position: fixed;
    inset: 0;
    width: min(92vw, 76rem);
    max-width: none;
    max-height: 92vh;
    margin: auto;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 0.75rem;
    background: #171315;
    color: #fffafc;
    box-shadow: 0 2rem 6rem rgba(12, 6, 9, 0.4);
  }

  .gallery-viewer[open] {
    animation: viewer-in 350ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .gallery-viewer::backdrop {
    background: rgba(18, 10, 14, 0.86);
    backdrop-filter: blur(0.5rem);
  }

  .gallery-viewer__frame {
    position: relative;
  }

  .gallery-viewer__media {
    display: grid;
    place-items: center;
    height: min(72vh, 48rem);
    overflow: hidden;
    border-radius: 0.75rem 0.75rem 0 0;
    background: #0d0b0c;
  }

  .gallery-viewer__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .gallery-viewer__close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 2;
    display: grid;
    width: 3rem;
    height: 3rem;
    place-items: center;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 250, 252, 0.94);
    color: #1a1a1a;
    cursor: pointer;
  }

  .gallery-viewer__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5rem;
    padding: 0.75rem 1rem 0.75rem 1.5rem;
  }

  .gallery-viewer__footer p {
    margin: 0;
    color: #fffafc;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  .gallery-viewer__controls {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 0.75rem;
  }

  .gallery-viewer__controls button {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid rgba(255, 250, 252, 0.24);
    border-radius: 50%;
    background: transparent;
    color: #fffafc;
    cursor: pointer;
    transition: border-color 200ms ease, background-color 200ms ease;
  }

  .gallery-viewer__controls button:hover {
    border-color: #f3117e;
    background: rgba(243, 17, 126, 0.18);
  }

  .gallery-viewer__position {
    min-width: 3rem;
    color: #e9dce3;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  @keyframes panel-reveal {
    from { opacity: 0; transform: translateY(1rem); filter: blur(0.25rem); }
    to { opacity: 1; transform: translateY(0); filter: blur(0); }
  }

  @keyframes image-reveal {
    from { opacity: 0; transform: translateY(1.25rem); clip-path: inset(8% 0 0); }
    to { opacity: 1; transform: translateY(0); clip-path: inset(0); }
  }

  @keyframes viewer-in {
    from { opacity: 0; transform: translateY(1rem) scale(0.985); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }

  @media (min-width: 48rem) {
    .gallery {
      padding-inline: clamp(1.5rem, 4vw, 3rem);
    }

    .gallery__panel-heading {
      grid-template-columns: minmax(15rem, 0.75fr) minmax(20rem, 1fr);
      align-items: end;
      margin-bottom: 2rem;
    }

    .gallery__grid {
      grid-template-columns: minmax(0, 1.45fr) minmax(0, 0.9fr);
    }
  }

  @media (max-width: 47.99rem) {
    .gallery__tabs {
      margin-right: -1rem;
      margin-left: -1rem;
      padding-left: 1rem;
    }

    .gallery__tab {
      flex: 0 0 auto;
    }

    .gallery__grid {
      grid-template-rows: clamp(15rem, 75vw, 25rem) clamp(10rem, 45vw, 16rem);
    }

    .gallery__image-action {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 35rem) {
    .gallery__grid {
      display: flex;
      flex-direction: column;
    }

    .gallery__image {
      aspect-ratio: 4 / 3;
    }

    .gallery__image--lead {
      aspect-ratio: 4 / 5;
    }

    .gallery-viewer {
      width: calc(100vw - 1rem);
      max-height: calc(100dvh - 1rem);
    }

    .gallery-viewer__media {
      height: min(68dvh, 34rem);
    }

    .gallery-viewer__footer {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
      padding: 1rem;
    }

    .gallery-viewer__controls {
      width: 100%;
      justify-content: space-between;
    }
  }

  :global(body.dark-mode) .gallery {
    --gallery-ink: #fffafc;
    --gallery-muted: #d8cbd2;
    background:
      linear-gradient(180deg, rgba(243, 17, 126, 0.08), transparent 18rem),
      #12110f;
  }

  :global(body.dark-mode) .gallery__tabs {
    border-color: #42383c;
  }

  :global(body.dark-mode) .gallery__tab {
    color: #c3b6bd;
  }

  :global(body.dark-mode) .gallery__tab:hover,
  :global(body.dark-mode) .gallery__tab[aria-selected="true"] {
    color: #fffafc;
  }

  @media (prefers-reduced-motion: reduce) {
    .gallery__panel:not([hidden]),
    .gallery__image,
    .gallery-viewer[open] {
      animation: none;
    }

    .gallery__tab::after,
    .gallery__image img,
    .gallery__image-action {
      transition: none;
    }
  }
</style>
