---
import ctaBg from '@assets/images/CTA/living-room.jpg';

import { Picture } from 'astro:assets';
---

<section id="cta">
  <div class="container">
    <h2 class="title">
      One call away from full-body relaxation!
      <br />
    </h2>
    <p>Your Wellness Starts Here – Experience the Benefits of Massage!</p>
     <a
          href="tel:587-938-0458"
          class="h-auto cs-button-solid w-[300px] rounded-full mt-8 text-center leading-snug p-4 text-[.6rem] md:text-[1rem] lg:w-[220px] xl:w-[230px]"
          >
          <span class="text-[1rem]">Call for Mobile Massage</span> <i class="fas fa-phone ml-1" aria-hidden="true"></i>
         </a>  
  </div>

  <Picture
    src={ctaBg}
    alt="stone arrangement with rolled towel"
    formats={['avif', 'webp']}
    loading="lazy"
    decoding="async"
  />
</section>

<style lang="less">
  /* Mobile */
  @media only screen and (min-width: 0em) {
    #cta {
      padding: (50/16rem) 0;
      position: relative;
      isolation: isolate;

      &:before {
        content: '';
        width: 100%;
        height: 100%;
        background: rgb(18 17 15 / 70%);
        pointer-events: none;
        display: block;
        position: absolute;
        top: 0;
        left: 0;
        z-index: 1;
      }

      .container {
        position: relative;
        z-index: 2;
        text-align: center;
      }

      .title {
        font-size: ~'min(9vw, 4rem)';
        //font-weight: 900;
        line-height: 58/48;
        text-align: center;
        margin-bottom: (36/16rem);
        color: var(--bodyTextColorWhite);
        position: relative;
      }
      .cs-button-solid {
        color: var(--on-action);
        border-radius: calc(32 / 16 * 1rem);
        &:before {
          border-radius: calc(32 / 16 * 1rem);
        }
      }

      p {
        text-align: center;
        width: 96%;
        max-width: (598/16rem);
        margin: auto;
        margin-bottom: (36/16rem);
        color: var(--bodyTextColorWhite);
        opacity: 1;
      }
    }
  }

  /* Small Desktop */
  @media only screen and (min-width: 64em) {
    #cta {
      padding: (168/16rem) 0;
    }
  }

  /* Large Desktop */
  @media only screen and (min-width: 1300px) {
    #cta {
      margin-top: (100/16rem);
      position: relative;
      &:before {
        width: 90.0625%;
        left: 50%;
        transform: translateX(-50%);
      }
      &:after {
        content: '';
        width: (2000/16rem);
        height: (1108/16rem);
        // background: url('/assets/svgs/cta-squares.svg');
        background-position: center;
        background-size: contain;
        background-repeat: no-repeat;
        opacity: 1;
        display: block;
        position: absolute;
        bottom: 0;
        left: 50%;
        z-index: -3;
        transform: translateX(-50%);
      }
      .container {
        width: 90.0625%;
        margin: auto;
      }
    }
  }

  /* Dark Mode */
  @media only screen and (min-width: 0em) {
    body.dark-mode {
      #cta {
        &:after {
          display: none;
        }
      }
    }
  }

  picture {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;

    img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      position: absolute;
      top: 0;
      left: 0;
    }
  }

  @media only screen and (min-width: 1300px) {
    picture {
      width: 90.0625%;
      left: 50%;
      transform: translateX(-50%);

    }
  }
</style>
