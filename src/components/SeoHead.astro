---
import client from '@data/client.json';
import { resolveSeo } from '@lib/seo';

interface Props {
  title?: string;
  description?: string;
}
const seo = await resolveSeo(
  Astro.url.pathname,
  Astro.site ?? new URL(client.domain),
  Astro.props
);
const imageUrl = new URL(seo.image.src, Astro.site ?? new URL(client.domain))
  .href;
---

<title>{seo.title}</title>
<meta name="description" content={seo.description} />
<link rel="canonical" href={seo.canonical} />
{!seo.indexable && <meta name="robots" content="noindex, follow" />}
<meta property="og:title" content={seo.socialTitle} />
<meta property="og:description" content={seo.socialDescription} />
<meta property="og:type" content={seo.type} />
<meta property="og:site_name" content={client.name} />
<meta property="og:locale" content="en_CA" />
<meta property="og:url" content={seo.canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:secure_url" content={imageUrl} />
<meta property="og:image:width" content={String(seo.image.width)} />
<meta property="og:image:height" content={String(seo.image.height)} />
<meta property="og:image:type" content={seo.image.type} />
<meta property="og:image:alt" content={seo.image.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seo.socialTitle} />
<meta name="twitter:description" content={seo.socialDescription} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={seo.image.alt} />
{
  seo.publishedTime && (
    <meta property="article:published_time" content={seo.publishedTime} />
  )
}
{seo.author && <meta name="author" content={seo.author} />}
