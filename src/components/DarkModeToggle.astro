---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button id="dark-mode-toggle" class={className} type="button" aria-label="Dark mode" aria-pressed="false">
  <svg
    class="cs-moon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 480 480"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M459.782 347.328c-4.288-5.28-11.488-7.232-17.824-4.96-17.76 6.368-37.024 9.632-57.312 9.632-97.056 0-176-78.976-176-176 0-58.4 28.832-112.768 77.12-145.472 5.472-3.712 8.096-10.4 6.624-16.832S285.638 2.4 279.078 1.44C271.59.352 264.134 0 256.646 0c-132.352 0-240 107.648-240 240s107.648 240 240 240c84 0 160.416-42.688 204.352-114.176 3.552-5.792 3.04-13.184-1.216-18.496z" />
  </svg>
  <svg class="cs-sun" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
  </svg>
</button>

<style>
  #dark-mode-toggle {
    color: var(--nav-text, var(--headerColor));
    cursor: pointer;
  }

  .cs-moon {
    fill: currentColor;
  }

  .cs-sun {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
  }

  #dark-mode-toggle.theme-toggle-standalone {
    position: fixed;
    inset-block-start: 1rem;
    inset-inline-end: 1rem;
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 4px 16px rgb(0 0 0 / 16%);
  }
</style>
