---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { formatDate } from "@js/utils";
import "@styles/blog.less";
import featuredPostOrder from '@data/featured-post-order.json';

const posts = await getCollection("blog");
// Preserve the existing sidebar order across Content Layer/glob updates.
const order = new Map(featuredPostOrder.map((id, index) => [id, index]));
const featuredPosts = posts
  .filter((post) => post.data.tags.includes('featured'))
  .sort((a, b) =>
    (order.get(a.id) ?? Number.MAX_SAFE_INTEGER) -
      (order.get(b.id) ?? Number.MAX_SAFE_INTEGER) || a.id.localeCompare(b.id)
  );
---

<!-- ============================================ --><!--                Featured Posts                --><!-- ============================================ -->
<div class="blog-sidebar">
  <!--Featured-->
  <div class="blog-featured-group">
    <span class="blog-header">Featured Posts</span>
    {
      featuredPosts.map((post) => (
        <a class="blog-feature" href={`/blog/${post.id}`}>
          <picture class="blog-featureImage">
            <Image
              src={post.data.image}
              alt={post.data.imageAlt}
              width="60"
              height="60"
              decoding="async"
            />
          </picture>
          <div class="content-group">
            <h3 class="feature-h3">{post.data.title}</h3>
            <span class="feature-date">Jun 14,2025</span>
          </div>
        </a>
      ))
    }
  </div>
</div>
