---
import { ClientRouter } from 'astro:transitions';
import SeoHead from '@components/SeoHead.astro';
import ThemeInit from '@components/ThemeInit.astro';
import SiteFonts from '@components/SiteFonts.astro';
import SiteIcons from '@components/SiteIcons.astro';
import DarkModeToggle from '@components/DarkModeToggle.astro';
import '@styles/root.less';
import '@styles/dark.less';
import '../styles/global.css';
import type { GetImageResult } from 'astro';

export interface Props {
  description?: string;
  title?: string;
  preloadedImage?: GetImageResult;
}

const { description, title, preloadedImage } = Astro.props;
---

<!-- A fully fleshed-out <head>, dynamically changing based on client.json and the page front matter -->
<html lang="en">
  <head>
    <!-- View Transitions support -->
    <ClientRouter />

    <!-- Standard meta tags -->
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SiteFonts />
    <SeoHead title={title} description={description} />
    <link
      href="https://fonts.googleapis.com/css2?family=Exo+2:ital,wght@0,100..900;1,100..900&family=Fjalla+One&family=Hammersmith+One&display=swap"
      rel="stylesheet"
    />
    {preloadedImage && <link rel="preload" href={preloadedImage.src} as="image" />}

    <!--Favicons-->
    <SiteIcons />
    <meta name="msapplication-TileColor" content="#da532c" />
    <meta name="theme-color" content="#ffffff" />

  </head>
  <body>
    <ThemeInit />
    <!--Screen reader skip main nav-->
    <a class="skip" aria-label="skip to main content" href="#main"
      >Click To Skip To Main Content</a
    >

    <DarkModeToggle class="theme-toggle-standalone" />
    <main id="main" class="relative">
      <slot />
    </main>
  </body>
</html>
